<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>HX</title>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700;900&display=swap" rel="stylesheet">
<style>
:root{--bg:#eef1ff;--card:#fff;--ink:#16193a;--mute:#5d6288;--acc:#2b45ff;--pop:#ffd84a;--line:#d5dafc;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#10122b;--card:#1a1d42;--ink:#eef0ff;--mute:#a3a8d6;--acc:#7f93ff;--pop:#ffd84a;--line:#2c3066}}
:root[data-theme="dark"]{--bg:#10122b;--card:#1a1d42;--ink:#eef0ff;--mute:#a3a8d6;--acc:#7f93ff;--pop:#ffd84a;--line:#2c3066}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:'Tajawal',system-ui,sans-serif;line-height:1.6}
.wrap{max-width:960px;margin:0 auto;padding:20px 16px 48px}
header{display:flex;justify-content:space-between;align-items:center;gap:12px}
.logo{font-weight:900;font-size:1.4rem}
.logo span{background:var(--pop);color:#16193a;padding:0 8px;border-radius:6px}
button{font-family:inherit;cursor:pointer}
#theme{background:none;border:1px solid var(--line);color:var(--ink);border-radius:20px;padding:4px 12px}
h1{font-size:clamp(2rem,8vw,3.4rem);font-weight:900;line-height:1.15;margin:28px 0 8px}
.sub{color:var(--mute);margin:0 0 20px}
#q{width:100%;padding:14px 16px;font:inherit;font-size:1rem;border:2px solid var(--line);border-radius:12px;background:var(--card);color:var(--ink)}
#q:focus,button:focus-visible{outline:3px solid var(--acc);outline-offset:2px}
.tabs{display:flex;gap:8px;margin:14px 0 20px;overflow-x:auto;padding-bottom:4px}
.tab{flex:none;border:1px solid var(--line);background:var(--card);color:var(--ink);padding:6px 16px;border-radius:20px;font-size:.95rem}
.tab[aria-pressed="true"]{background:var(--acc);border-color:var(--acc);color:#fff}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:14px}
.item{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;display:flex;flex-direction:column;gap:8px}
.ico{width:48px;height:48px;border-radius:12px;display:grid;place-items:center;font-size:1.6rem;background:var(--pop)}
.item h3{margin:0;font-size:1.1rem}
.item p{margin:0;color:var(--mute);font-size:.9rem;flex:1}
.meta{font-size:.8rem;color:var(--mute)}
.dl{position:relative;overflow:hidden;border:0;background:var(--acc);color:#fff;padding:10px;border-radius:10px;font-weight:700;font-size:1rem}
.dl i{position:absolute;inset:0 auto 0 0;width:0;background:rgba(255,255,255,.3)}
.dl span{position:relative}
.empty{text-align:center;color:var(--mute);padding:40px 0}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}

.admin{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin:20px 0;display:grid;gap:10px}
.admin label{font-size:.9rem;color:var(--mute);display:grid;gap:4px}
.admin input,.admin textarea,.admin select{font:inherit;padding:10px;border:2px solid var(--line);border-radius:10px;background:var(--bg);color:var(--ink)}
.row{display:flex;gap:8px;flex-wrap:wrap}.row>*{flex:1}
.btn{border:0;background:var(--acc);color:#fff;padding:10px 16px;border-radius:10px;font-weight:700;font-size:1rem}
.btn.alt{background:var(--card);color:var(--ink);border:1px solid var(--line)}.btn.del{background:#d93a3a}
.thumb{width:100%;height:120px;object-fit:cover;border-radius:10px}
#msg{color:var(--mute);font-size:.9rem;min-height:1.4em}
[hidden]{display:none!important}
</style>
</head>
<body>
<div class="wrap">
<header><div class="logo" role="img" aria-label="HX"><svg viewBox="0 0 120 100" width="64" height="53" style="display:block;color:var(--ink)"><g fill="currentColor"><rect x="4" y="6" width="18" height="88" rx="9"/><rect x="40" y="6" width="18" height="88" rx="9"/><rect x="4" y="42" width="54" height="16" rx="8"/></g><g stroke-linecap="round" fill="none"><path d="M72 22L108 78M108 22L72 78" stroke="currentColor" stroke-width="30"/><path d="M72 22L108 78M108 22L72 78" stroke="var(--bg)" stroke-width="13"/></g></svg></div><span><button id="theme" aria-label="تغيير المظهر">🌓 المظهر</button></span></header>
<h1>ملفات وألعاب<br>بضغطة واحدة</h1>
<p class="sub">ابحث، اختر، وحمّل.</p>
<!-- إزالة onsubmit الخاطئة من هنا -->
<form id="admin" class="admin" hidden>
<b>إضافة ملف أو لعبة (للإدارة فقط)</b><div class="meta">التعديلات تُحفظ كمسودة في متصفحك. لنشرها للجميع: «تصدير items.json» ثم ارفع الملف إلى GitHub.</div>
<label>اسم الملف<input id="fn" required></label>
<label>الوصف<textarea id="fd" rows="3"></textarea></label>
<div class="row"><label>القسم<select id="fc"><option>ملفات</option><option>ألعاب</option><option>أدوات</option></select></label>
<label>الحجم (اختياري)<input id="fs" placeholder="مثال: 12 MB"></label></div>
<label>الصورة<input id="fi" type="file" accept="image/*"></label>
<label>رابط التحميل (Drive / Mega / ...)<input id="fu" type="url" required dir="ltr" placeholder="https://"></label>
<div class="row"><button class="btn" id="save" type="submit">نشر</button><button class="btn alt" id="reset" type="button">مسح الحقول</button><button class="btn alt" id="close" type="button">إغلاق</button></div><div class="row"><button class="btn" id="export" type="button">تصدير items.json</button><button class="btn alt" id="discard" type="button">تفريغ المسودة</button></div>
<div id="msg" role="status"></div>
<b>المنشورات</b><div id="list" class="grid"></div>
</form>
<input id="q" type="search" placeholder="ابحث عن ملف أو لعبة…" aria-label="بحث">
<div class="tabs" id="tabs"></div>
<div class="grid" id="grid"></div>
<p class="empty" id="empty" hidden>لا توجد نتائج. جرّب كلمة أخرى أو قسمًا آخر.</p>
</div>
<script>
const $=id=>document.getElementById(id);
const CODE="HX2423DEV",KEY="hx_draft_v1";
let LOCAL=false,PUB=[],ITEMS=[],cats=["الكل"],cat="الكل",term="",adminOn=false;
const esc=t=>String(t==null?"":t).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const ls={get(){try{return JSON.parse(localStorage.getItem(KEY))}catch(e){return null}},set(v){try{localStorage.setItem(KEY,JSON.stringify(v))}catch(e){$("msg").textContent="تعذر حفظ المسودة في المتصفح"}},clear(){try{localStorage.removeItem(KEY)}catch(e){}}};

function tabs(){
  cats=["الكل",...new Set(ITEMS.map(x=>x.c))];
  if(!cats.includes(cat))cat="الكل";
  $("tabs").innerHTML="";
  cats.forEach(c=>{
    const b=document.createElement("button");
    b.type="button"; // إصلاح: منع الزر من العمل كزر Submit
    b.className="tab";
    b.textContent=c;
    b.setAttribute("aria-pressed",c===cat);
    b.onclick=()=>{cat=c;tabs();render()};
    $("tabs").appendChild(b)
  })
}

function card(x,adm){
 const el=document.createElement("div");el.className="item";
 const pic=x.img?`<img class="thumb" alt="" src="${esc(x.img)}">`:`<div class="ico">📦</div>`;
 el.innerHTML=pic+`<h3>${esc(x.n)}</h3><p>${esc(x.d)}</p><div class="meta">${esc(x.c)}${x.s?" · "+esc(x.s):""}</div>`;
 const b=document.createElement("button");
 b.type="button"; // إصلاح: تحديد النوع لتجنب تفعيل النموذج عند ضغط 'حذف'
 
 if(adm){
  b.className="btn del";b.textContent="حذف";let armed=false;
  b.onclick=()=>{
   if(!armed){armed=true;b.textContent="اضغط للتأكيد";setTimeout(()=>{armed=false;b.textContent="حذف"},4000);return}
   ITEMS=ITEMS.filter(y=>y.id!==x.id);ls.set(ITEMS);tabs();render()
  }
 } else {
  b.className="dl";b.innerHTML="<i></i><span>تحميل</span>";
  b.onclick=()=>{
   if(!/^https?:\/\//i.test(x.url||"")){b.querySelector("span").textContent="غير متوفر";return}
   window.open(x.url,"_blank","noopener");
   b.querySelector("span").textContent="تم ✓";
   setTimeout(()=>b.querySelector("span").textContent="تحميل",1800)
  }
 }
 el.appendChild(b);return el
}

function render(){
 const list=ITEMS.filter(x=>(cat==="الكل"||x.c===cat)&&((x.n||"")+(x.d||"")).includes(term));
 $("empty").hidden=list.length>0;$("empty").textContent=ITEMS.length?"لا توجد نتائج. جرّب كلمة أخرى أو قسمًا آخر.":"لا توجد منشورات بعد.";
 $("grid").innerHTML="";list.forEach(x=>$("grid").appendChild(card(x,false)));
 if(adminOn){$("list").innerHTML="";ITEMS.forEach(x=>$("list").appendChild(card(x,true)))}
}

function showAdmin(on){adminOn=on;$("admin").hidden=!on;if(on){const d=ls.get();ITEMS=Array.isArray(d)?d:PUB.slice()}else ITEMS=LOCAL?(ls.get()||[]):PUB.slice();tabs();render()}

$("q").oninput=e=>{term=e.target.value.trim();if(term===CODE){e.target.value="";term="";showAdmin(true);return}render()};
$("theme").onclick=()=>{const r=document.documentElement,d=getComputedStyle(r).getPropertyValue("--bg").trim()==="#10122b";r.dataset.theme=d?"light":"dark"};
$("close").onclick=()=>showAdmin(false);
$("reset").onclick=()=>{$("admin").reset();$("msg").textContent=""};
$("discard").onclick=()=>{if($("discard").dataset.a!=="1"){$("discard").dataset.a="1";$("discard").textContent="اضغط للتأكيد";setTimeout(()=>{$("discard").dataset.a="";$("discard").textContent="تفريغ المسودة"},4000);return}ls.clear();$("discard").dataset.a="";$("discard").textContent="تفريغ المسودة";showAdmin(true)};
$("export").onclick=()=>{const b=new Blob([JSON.stringify(ITEMS,null,1)],{type:"application/json"}),a=document.createElement("a");a.href=URL.createObjectURL(b);a.download="items.json";document.body.appendChild(a);a.click();a.remove();$("msg").textContent="تم تنزيل items.json. ارفعه إلى GitHub مكان القديم."};

function shrink(f){return new Promise((ok,no)=>{const u=URL.createObjectURL(f),i=new Image();
 i.onload=()=>{const m=640,k=Math.min(1,m/Math.max(i.width,i.height)),c=document.createElement("canvas");c.width=Math.round(i.width*k);c.height=Math.round(i.height*k);
  c.getContext("2d").drawImage(i,0,0,c.width,c.height);URL.revokeObjectURL(u);
  let q=.8,d=c.toDataURL("image/jpeg",q);while(d.length>150000&&q>.3){q-=.1;d=c.toDataURL("image/jpeg",q)}ok(d)};
 i.onerror=()=>no(new Error("تعذر قراءة الصورة، جرّب JPG أو PNG"));i.src=u})}

// إصلاح: تم التغيير من $("save").onclick إلى $("admin").onsubmit لكي تعمل حقول Required
$("admin").onsubmit=async(e)=>{
 e.preventDefault(); // يمنع إعادة تحميل الصفحة
 const n=$("fn").value.trim(),lk=$("fu").value.trim();
 if(!n||!/^https?:\/\//i.test(lk)){$("msg").textContent="اكتب اسم الملف ورابط تحميل صحيح يبدأ بـ https://";return}
 $("save").disabled=true;$("msg").textContent="جارٍ الإضافة…";
 try{
  const doc={id:"i"+Date.now(),n,d:$("fd").value.trim(),c:$("fc").value,s:$("fs").value.trim(),url:lk,t:Date.now()};
  const im=$("fi").files[0];if(im)doc.img=await shrink(im);
  ITEMS.unshift(doc);ls.set(ITEMS);$("admin").reset();tabs();render();
  $("msg").textContent="أُضيف إلى المسودة ✓ اضغط «تصدير items.json» ثم ارفعه إلى GitHub لنشره للجميع.";
 }catch(er){$("msg").textContent="تعذر الإضافة: "+((er&&er.message)||"خطأ")}
 $("save").disabled=false
};

tabs();render();
fetch("items.json?v="+Date.now()).then(r=>r.ok?r.json():[]).catch(()=>{LOCAL=true;return ls.get()||[]}).then(d=>{PUB=Array.isArray(d)?d:[];if(!adminOn){ITEMS=PUB.slice();tabs();render()}});
</script>
</body>
</html>
